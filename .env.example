APP_NAME=FOLEM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# En production : APP_ENV=production, APP_DEBUG=false, APP_URL en https
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Ouagadougou

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite par défaut pour démarrer vite. En production, préférer MySQL/MariaDB.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=folem
# DB_USERNAME=folem
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Passer à true dès que le site tourne en https
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@cerfi.bf"
MAIL_FROM_NAME="${APP_NAME}"

#
# Paiement mobile money LigdiCash
# Clés à récupérer sur le tableau de bord LigdiCash, projet API activé.
# LIGDICASH_PLATFORM=test tant que les tests ne sont pas terminés.
#
LIGDICASH_API_KEY=
LIGDICASH_AUTH_TOKEN=
LIGDICASH_STORE_NAME="FOLEM - CERFI"

#
# Contenus du site public
# Les URLs de réseaux sociaux laissées vides ne s'affichent pas dans le pied de page.
#
FOLEM_CONTACT_EMAIL=contact@cerfi.bf
FOLEM_FACEBOOK_URL=
FOLEM_LINKEDIN_URL=
FOLEM_YOUTUBE_URL=
FOLEM_WHATSAPP_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
